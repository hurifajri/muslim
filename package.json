{
  "name": "muslim",
  "version": "2.1.2",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "prepare": "husky",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:install": "agent-browser install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check src scripts tests",
    "format:fix": "prettier --write src scripts tests",
    "check": "pnpm lint && pnpm format && pnpm check:types",
    "fix": "pnpm lint:fix && pnpm format:fix",
    "check:types": "tsc --noEmit --pretty",
    "check:packages": "npm exec npm-check-updates",
    "update:packages": "npm exec npm-check-updates -- -u"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0",
    "vaul": "^1.1.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@serwist/turbopack": "^9.5.13",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "agent-browser": "0.41.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "typescript": "^6.0.3"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
